# Local SQLite database.
SQLITE_PATH=data/podcast.db

API_BASE_URL=http://localhost:8080
FFMPEG_PATH=ffmpeg

# Generated audio/chunk artifacts are stored on the local filesystem.
LOCAL_STORAGE_PATH=data/storage

# Optional OpenAI adapters. Routine tests and ./init.sh do not require this key.
# OPENAI_API_KEY=
# whisper-1 stores verbose segment timestamps; gpt-4o/gpt-4o-mini transcribe models store text with chunk association.
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_SUMMARIZE_MODEL=gpt-4o-mini
