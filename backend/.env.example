# Default demo mode: one local SQLite file, no Postgres or Valkey required.
STORAGE_DRIVER=sqlite
SQLITE_PATH=data/podcast.db

# Optional production/cloud mode.
# STORAGE_DRIVER=postgres
# POSTGRES_URL=postgres://user:password@host:5432/podcast_summarizer?sslmode=require
# VALKEY_URL=redis://default:password@host:6379

API_BASE_URL=http://localhost:8080
FFMPEG_PATH=ffmpeg

# Generated audio/chunk artifacts. Use "local" for demo/self-hosting, "r2" for Cloudflare R2, or "none".
OBJECT_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=data/storage

# Optional external adapters. If unset, the app uses local stubs.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_SUMMARIZE_MODEL=gpt-4o-mini
# TRANSCRIBE_URL=
# TRANSCRIBE_KEY=
# SUMMARIZE_URL=
# SUMMARIZE_KEY=

# Optional Cloudflare R2 storage for generated media artifacts.
# OBJECT_STORAGE_DRIVER=r2
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_BASE_URL=
